# ============================================
# Variables de Entorno - comoelmusguito
# ============================================
# Copia este archivo a .env.local y completa los valores

# ============================================
# CONFIGURACIÓN GENERAL
# ============================================
NEXT_PUBLIC_SITE_URL=https://comoelmusguito.cl
NEXT_PUBLIC_SITE_NAME=comoelmusguito

# Número de teléfono de contacto (formato: +56966563208 sin espacios)
# Se usa en todas las páginas que muestran información de contacto
NEXT_PUBLIC_PHONE_NUMBER=+56966563208

# ============================================
# SANITY CMS
# ============================================
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=your_api_token_here
SANITY_WEBHOOK_SECRET=your_webhook_secret

# ============================================
# FLOW PAYMENTS (Chile)
# ============================================
# Flow.cl es el procesador de pagos para Chile
# 
# Setup:
#   1. Crear cuenta: https://www.flow.cl
#   2. Obtener API Key y Secret Key: https://www.flow.cl/app/web/misDatos.php
#   3. Configurar URLs de retorno y confirmación
#
# Sandbox para pruebas:
#   - URL: https://sandbox.flow.cl/app/web/misDatos.php
#   - FLOW_ENV=sandbox
FLOW_API_KEY=your_flow_api_key
FLOW_SECRET_KEY=your_flow_secret_key
FLOW_ENV=sandbox # 'sandbox' para pruebas, 'production' para producción

# ============================================
# STRIPE PAYMENTS (Deprecated - Reemplazado por Flow)
# ============================================
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
# STRIPE_SECRET_KEY=sk_test_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ============================================
# AUTENTICACIÓN (NextAuth.js)
# ============================================
# NextAuth se usa para login de usuarios (acceso a cursos comprados)
# 
# NEXTAUTH_URL: URL de tu sitio
#   - Desarrollo: http://localhost:3000
#   - Producción: https://comoelmusguito.cl
NEXTAUTH_URL=http://localhost:3000

# NEXTAUTH_SECRET: String aleatorio para encriptar sesiones
#   - Generar con: openssl rand -base64 32
#   - O en terminal: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=your_nextauth_secret_here

# ============================================
# LOGIN SOCIAL (Opcional - Solo si quieres "Login con Google/GitHub")
# ============================================
# 🔵 Google OAuth: https://console.cloud.google.com/
# ⚫ GitHub OAuth: https://github.com/settings/developers
# 
# Para MVP: Puedes dejar esto vacío y usar solo email/password
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================
# VIDEO HOSTING (Para cursos online)
# ============================================
# OPCIÓN 1: Bunny.net Stream (Recomendado) - $10-20/mes
#   - Crear cuenta: https://bunny.net
#   - Panel → Stream → API Key
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=

# OPCIÓN 2: Vimeo Pro - $75/mes
#   - Crear cuenta Pro: https://vimeo.com/upgrade
#   - Generar token: https://developer.vimeo.com/apps
VIMEO_ACCESS_TOKEN=
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=

# OPCIÓN 3: YouTube Unlisted (Gratis - para MVP)
#   - Solo subir videos como "unlisted" y usar YouTube player
#   - No requiere API key para embeds públicos
# YOUTUBE_API_KEY= (solo si necesitas gestión programática)

# ⚠️ SANITY NO ES RECOMENDADO para videos largos de cursos

# ============================================
# EMAIL - Resend (Recomendado) ⭐
# ============================================
# Plan Free: 3,000 emails/mes, 100/día - Suficiente para empezar
# 
# Setup:
#   1. Crear cuenta: https://resend.com/signup
#   2. Agregar dominio (comoelmusguito.cl) o usar onboarding@resend.dev
#   3. Generar API Key: https://resend.com/api-keys
#
# Uso: Confirmaciones de compra, acceso a cursos, newsletter, etc.
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=hola@comoelmusguito.cl

# Verificación de Email al Registro
#   - true: Requiere verificar email antes de poder hacer login (recomendado para producción)
#   - false: Permite login inmediato sin verificar email (útil para desarrollo/testing)
#   - Default: true (si no se especifica, se requiere verificación)
REQUIRE_EMAIL_VERIFICATION=true

# ============================================
# ANALYTICS
# ============================================

# OPCIÓN 1: Vercel Analytics (Recomendado para MVP) - Gratis
#   - Ya incluido en Vercel, auto-activado
#   - No requiere configuración adicional
#   - Ver: https://vercel.com/analytics

# OPCIÓN 2: Plausible (Recomendado para producción) - $9/mes
#   - Privacy-first, GDPR compliant (sin cookies, sin banner)
#   - Lightweight (<1KB vs 45KB de Google Analytics)
#   - UI simple y clara
#   - Crear cuenta: https://plausible.io
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=comoelmusguito.cl

# OPCIÓN 3: Google Analytics (Opcional)
#   - Gratis pero invasivo (requiere banner de cookies)
#   - Setup: https://analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console (Para SEO - Recomendado)
#   - Monitorear rankings, errores, indexación
#   - Crear cuenta: https://search.google.com/search-console
NEXT_PUBLIC_GSC_VERIFICATION=your_verification_code

# ============================================
# SEO & SOCIAL
# ============================================
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/comoelmusguito
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@comoelmusguito
NEXT_PUBLIC_TWITTER_HANDLE=@comoelmusguito

# ============================================
# INSTAGRAM API (Para mostrar feed en home)
# ============================================
# Instagram Basic Display API
# Setup: https://developers.facebook.com/docs/instagram-basic-display-api
# 
# Pasos:
#   1. Crear app en https://developers.facebook.com
#   2. Agregar producto "Instagram Basic Display"
#   3. Configurar OAuth Redirect URI: http://localhost:3000/api/instagram/callback
#   4. Obtener App ID y App Secret
#   5. Autorizar app y obtener access token
#   6. Intercambiar por long-lived token (60 días)
#
# Ver guía completa: docs/INSTAGRAM_INTEGRATION.md
INSTAGRAM_APP_ID=tu_app_id
INSTAGRAM_APP_SECRET=tu_app_secret
INSTAGRAM_ACCESS_TOKEN=tu_long_lived_token
# Nota: INSTAGRAM_REDIRECT_URI se construye automáticamente usando NEXT_PUBLIC_SITE_URL + '/api/instagram/callback'

# ============================================
# VERCEL API (Para actualización automática de token)
# ============================================
# Configuración para que el cron job actualice automáticamente
# el token de Instagram en Vercel cada 50 días
#
# Pasos:
#   1. Crear token en: https://vercel.com/account/tokens
#   2. Obtener Project ID: Settings → General → Project ID
#   3. Team ID (opcional): Solo si es proyecto de team
#   4. Generar CRON_SECRET: openssl rand -base64 32
#
# Ver guía completa: docs/INSTAGRAM_AUTO_REFRESH.md
VERCEL_TOKEN=tu_vercel_api_token
VERCEL_PROJECT_ID=tu_project_id
VERCEL_TEAM_ID=tu_team_id  # Opcional, solo si es proyecto de team
CRON_SECRET=tu_cron_secret_aqui  # Secret para proteger el endpoint del cron

# ============================================
# RATE LIMITING - Upstash Redis (Recomendado) ⭐
# ============================================
# Rate limiting para proteger endpoints críticos (login, registro, checkout)
# 
# Setup:
#   1. Crear cuenta: https://upstash.com/
#   2. Crear base de datos Redis: https://console.upstash.com/redis
#   3. Copiar REST URL y REST Token
#   4. Plan Free: 10,000 comandos/día - Suficiente para empezar
#
# Uso: Previene ataques de fuerza bruta, spam, y abuso de API
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here
#
# Nota: Si no se configuran, el rate limiting se desactiva (modo desarrollo)
# En producción, siempre configurar Upstash para seguridad

# ============================================
# GEOLOCALIZACIÓN (Para detectar país del usuario)
# ============================================
# Uso: Mostrar precios correctos (CLP/USD), filtrar productos por región
#
# OPCIÓN 1: Vercel Headers (Recomendado - GRATIS) ⭐
#   - Ya incluido si deployeas en Vercel
#   - No requiere API key
#   - headers().get('x-vercel-ip-country')
#   - Suficientemente preciso
# (No necesita configuración)

# OPCIÓN 2: ipapi.co (Freemium - 1000 requests/día gratis)
#   - Solo si necesitas más precisión
#   - https://ipapi.co/
# IPAPI_KEY=

# OPCIÓN 3: MaxMind GeoLite2 (Gratis pero complejo)
#   - Requiere descargar database
#   - https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
# MAXMIND_LICENSE_KEY=

# ============================================
# MODO DESARROLLO
# ============================================
# Variables solo para desarrollo local
NODE_ENV=development

